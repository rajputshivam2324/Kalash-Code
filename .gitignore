# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.python-version

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Secrets - anchored or file-specific so they cannot swallow source files
# (hatchling honours .gitignore when it builds the wheel; a bare `credentials`
# pattern once excluded src/kalash/credentials.py from the package).
.env
.env.*
!.env.example
*.pem
id_rsa*
id_ed25519*
/auth.json
/auth.key
/secrets.json
.netrc

# Private development instructions, configuration and session artifacts.
# Anchor these rules so package code and test fixtures remain publishable.
/.kalash/
/.agents/
/.codex/
/.claude/
/.cursor/
/.opencode/
/.playwright-mcp/
/AGENTS.md
/CLAUDE.md
/KALASH.md
/NEXT_SESSION*.md
/HANDOFF*.md
/SESSION*.md
/docs/history/
/docs/judge/
/docs/evals/
/docs/session_history/
/docs/design/

# Logs, editors, OS
*.log
*.tmp
*.bak
*.swp
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
