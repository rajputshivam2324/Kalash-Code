# ---------------------------------------------------------------------------
# Python bytecode / caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------------------------------------------------------------------------
# Build & packaging artifacts (hatchling)
# ---------------------------------------------------------------------------
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Tooling caches (ruff, mypy, pytest, coverage)
# ---------------------------------------------------------------------------
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
.pytest_cache/
.cache/
.hypothesis/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml

# ---------------------------------------------------------------------------
# Secrets & credentials — never commit (docs/permissions.md protected paths)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
credentials
credentials.*
!credentials.example.*
.netrc
*.p12
*.pfx
auth.json
secrets.json

# ---------------------------------------------------------------------------
# Kalash project-local state
# Committed:  .kalash/settings.json, .kalash/config.toml, skills/, agents/
# Ignored:    caches, local overrides, runtime data
# ---------------------------------------------------------------------------
.kalash/cache/
.kalash/logs/
.kalash/blobs/
.kalash/*.local.json
.kalash/*.local.toml
.kalash/settings.local.json
.kalash/config.local.toml
.kalash/credentials*

# Atomic-write temp files from tools/fs.py
.kalash_*.tmp

# Local SQLite databases (real store lives at ~/.kalash/kalash.db)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Logs & temp files
# ---------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
.spyderproject
.ropeproject

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
node_modules/
.ipynb_checkpoints/
profile.out
*.prof
