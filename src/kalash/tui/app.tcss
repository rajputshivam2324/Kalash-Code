/* Kalash terminal UI. Colours come from the active theme ($primary is the saffron accent). */

Screen {
    layout: vertical;
    background: $background;
}

* {
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $primary-muted;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-size-vertical: 1;
}

#transcript {
    height: 1fr;
    padding: 0 2;
    scrollbar-size-vertical: 1;
    scrollbar-gutter: stable;
    background: $background;
}

/* ---- messages ---------------------------------------------------------------------- */

.user {
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: thick $primary;
    background: $surface;
    color: $text;
}

.user.queued {
    border-left: thick $primary-muted;
    color: $text-muted;
}

.assistant {
    margin: 1 0 1 0;
    padding: 0 1;
    height: auto;
}

.assistant Markdown {
    padding: 0;
    margin: 0;
    background: transparent;
}

.assistant MarkdownFence {
    background: $surface;
    margin: 1 0;
}

.reasoning {
    margin: 1 0 0 0;
    padding: 0 1;
    color: $text-muted;
    text-style: italic;
}

.notice {
    margin: 1 0 0 0;
    padding: 0 1;
    color: $text-muted;
}

.notice.-warning {
    color: $warning;
}

.notice.-error {
    color: $error;
}

.error-card {
    margin: 1 0 0 0;
    padding: 0 2;
    border-left: thick $error;
    background: $error-muted;
    color: $text;
}

.welcome {
    margin: 1 0 0 0;
    padding: 1 3;
    border: round $primary-muted;
    background: $background;
    height: auto;
}

/* ---- tool calls -------------------------------------------------------------------- */

.tool {
    height: auto;
    margin: 0;
    padding: 0 1;
}

.explore {
    height: 1;
    margin: 0;
    padding: 0 1;
}

.explore:hover {
    background: $surface;
}

.turn-footer {
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $text-muted;
}

.tool.has-body {
    margin-bottom: 1;
}

.tool-head {
    height: 1;
    color: $text;
}

.tool-head:hover {
    background: $surface;
}

.tool-body {
    height: auto;
    padding: 0 0 0 2;
    margin: 0 0 0 1;
    border-left: tall $primary-muted;
}

/* ---- bottom area ------------------------------------------------------------------- */

#activity {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

#suggestions {
    display: none;
    height: auto;
    max-height: 14;
    margin: 0 1;
    border: round $primary-muted;
    border-subtitle-color: $foreground-muted;
    background: $surface;
    padding: 0;
}

#suggestions > .option-list--option-disabled {
    color: $primary;
    text-style: bold;
}

#prompt {
    height: auto;
    min-height: 3;
    max-height: 12;
    margin: 0 1;
    padding: 0 1;
    border: round $primary-muted;
    background: $surface;
    color: $text;
}

#prompt:focus {
    border: round $primary;
}

#prompt > .text-area--placeholder {
    color: $text-muted;
}

.mode-plan #prompt:focus { border: round $secondary; }
.mode-auto #prompt:focus { border: round $warning; }
.mode-full #prompt:focus { border: round $error; }
.mode-read-only #prompt:focus { border: round $foreground-muted; }

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* ---- dialogs ----------------------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 86%;
    max-width: 110;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.dialog-title {
    margin-bottom: 1;
    color: $primary;
}

.dialog-title.warn { color: $warning; }
.dialog-title.plan { color: $secondary; }

.dialog-line {
    margin-bottom: 0;
}

#approval-detail {
    height: auto;
    max-height: 18;
    margin: 1 0;
    padding: 0 1;
    border-left: tall $primary-muted;
    background: $background;
}

#approval-actions, #plan-actions, #confirm-actions {
    height: auto;
    margin-top: 1;
}

#approval-actions Button, #plan-actions Button, #confirm-actions Button {
    margin-right: 2;
}

#plan-body {
    height: auto;
    max-height: 22;
    border-left: thick $secondary;
    padding: 0 1;
    background: $background;
}

#plan-body Markdown {
    padding: 0;
    margin: 0;
    background: transparent;
}

#plan-body MarkdownH1, #plan-body MarkdownH2, #plan-body MarkdownH3 {
    margin: 0 0 1 0;
    padding: 0;
}

#plan-feedback {
    margin-top: 1;
}

#picker-list {
    height: auto;
    max-height: 22;
    margin-top: 1;
    background: $surface;
}

#help {
    height: 90%;
}

#help-body {
    height: 1fr;
}

#help-footer {
    height: 1;
    margin-top: 1;
}

Button:focus {
    text-style: bold underline;
}

Toast {
    background: $panel;
}
